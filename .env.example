# Environment Configuration
ENVIRONMENT=development  # development, production, testing

# Database Configuration
DATABASE_URL=sqlite:///skating_analysis.db
# For PostgreSQL: postgresql://user:password@localhost:5432/skating_db

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Security
SECRET_KEY=change-me-in-production-use-strong-random-key
JWT_SECRET_KEY=change-me-in-production-jwt-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Application Settings
APP_NAME=Figure Skating Analysis System
APP_VERSION=1.0.0
DEBUG=True
TESTING=False

# Logging
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_FILE=logs/app.log

# File Upload
MAX_UPLOAD_SIZE_MB=500
ALLOWED_HOSTS=*

# Video Processing
VIDEO_FPS=30
VIDEO_RESOLUTION_WIDTH=1280
VIDEO_RESOLUTION_HEIGHT=720
MAX_FRAMES_TO_PROCESS=1000

# Model Settings
MODEL_CONFIDENCE_THRESHOLD=0.7
POSE_MIN_DETECTION_CONFIDENCE=0.5
POSE_MIN_TRACKING_CONFIDENCE=0.5
POSE_MODEL_COMPLEXITY=2

# Performance
ENABLE_CACHE=True
CACHE_TTL_SECONDS=3600
MAX_WORKERS=4

# External Services (if needed)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# S3_BUCKET_NAME=

# Email Configuration (for notifications)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# EMAIL_FROM=
